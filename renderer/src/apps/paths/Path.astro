---
import PathViewer from '@apps/paths/PathViewer';
import { fetchPathResponse } from '@backend/tina';
import PageStoreProvider from '@components/PageStoreProvider';

const { slug, publishedOnly } = Astro.props;
const pathResponse = await fetchPathResponse(slug);
const path = pathResponse?.data?.path;

// No path (longform moves to WordPress in migration step 2 — until then there
// is none) or an unpublished one under publishedOnly: 404.
if (!path || (publishedOnly && !path.published)) {
  return new Response(null, { status: 404 });
}

---

<PathViewer
  {...pathResponse}
  client:only='react'
/>

<PageStoreProvider
  title={path?.title}
  client:load
/>