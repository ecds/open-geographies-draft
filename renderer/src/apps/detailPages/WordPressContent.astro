---
import { getAtlasConfig } from '@atlas/server';
import { fetchWordPressDocument } from '@backend/wordpress';
import WordPressBody from '@components/WordPressBody.astro';

/**
 * Renders per-record longform fetched from the atlas's WordPress, for a detail
 * page. Enabled per-model via config:
 *
 *   "detail_pages": {
 *     "models": {
 *       "places": {
 *         "wordpress": {
 *           "host": "https://wp.example.org",
 *           "field": "<user-defined field UUID holding the post id or slug>",
 *           "resource": "posts"
 *         }
 *       }
 *     }
 *   }
 *
 * The record's user-defined field supplies the WordPress id/slug. Falls back to
 * the site-wide `config.wordpress.host` when a per-model host isn't set.
 */
interface Props {
  model: string;
  record: any;
}

const { model, record } = Astro.props;

const config = getAtlasConfig();
const wordpress = config.detail_pages?.models?.[model]?.wordpress;
const value = wordpress && record.user_defined?.[wordpress.field]?.value;

const document = await fetchWordPressDocument({
  host: wordpress?.host || config.wordpress?.host,
  resource: wordpress?.resource || 'posts',
  value
});
---

<WordPressBody content={document?.content} />
