---
import Paths from '@apps/paths/Paths';
import Container from '@components/Container.astro';
import { getAtlasConfig } from '@atlas/server';
import config from '@config';
import Layout from '@layouts/Layout.astro';
import { hasPathsContent } from '@utils/config';
import _ from 'underscore';

// Build-time only (not called in SSR); the static defaults seed any prerender.
export const getStaticPaths = () => {
  if (!hasPathsContent(config)) {
    return [];
  }

  return _.map(config.i18n.locales, (lang: string) => ({ params: { lang }}));
};

// Per-request: the current atlas's paths config (layout, categories, sort_by).
const pathsConfig = getAtlasConfig().content?.paths_config;

---

<Layout
  footer
  titleKey='paths'
>
  <Container
    className='pb-16 w-full'
  >
    <Paths
      lang={Astro.currentLocale}
      config={pathsConfig}
      client:only='react'
    />
  </Container>
</Layout>