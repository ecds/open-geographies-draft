{
  "family": "og-renderer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/og-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/og-renderer-task-role",
  "containerDefinitions": [
    {
      "name": "renderer",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/og-renderer:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "OG_BASE_DOMAIN", "value": "opengeographies.org" },
        { "name": "OG_CONSOLE_URL", "value": "http://coredata.internal.opengeographies.org" },
        { "name": "OG_ATLAS_CACHE_TTL_MS", "value": "90000" },
        { "name": "OG_ATLAS_ERROR_TTL_MS", "value": "5000" },
        { "name": "OG_ATLAS_FETCH_TIMEOUT_MS", "value": "5000" },
        { "name": "OG_WORDPRESS_TIMEOUT_MS", "value": "5000" }
      ],
      "secrets": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://localhost:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/og-renderer",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "renderer",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
