diff --git a/app/controllers/concerns/core_data_connector/public/discoverable_project_scope.rb b/app/controllers/concerns/core_data_connector/public/discoverable_project_scope.rb
new file mode 100644
index 0000000..8e2e323
--- /dev/null
+++ b/app/controllers/concerns/core_data_connector/public/discoverable_project_scope.rb
@@ -0,0 +1,34 @@
+module CoreDataConnector
+  module Public
+    # Scopes public API requests to projects with discoverable = true. Records belonging to
+    # non-discoverable projects are not served by the public API, regardless of how they
+    # are addressed (project_ids parameter, record UUID, or nested route).
+    module DiscoverableProjectScope
+      extend ActiveSupport::Concern
+
+      protected
+
+      # Returns the subset of the requested project_ids that belong to discoverable projects.
+      def discoverable_project_ids
+        @discoverable_project_ids ||= Project
+                                        .where(id: requested_project_ids)
+                                        .where(discoverable: true)
+                                        .pluck(:id)
+      end
+
+      # Returns a sub-query for the IDs of all discoverable projects, for routes that can be
+      # called without a project_ids parameter.
+      def discoverable_projects
+        Project
+          .where(discoverable: true)
+          .select(:id)
+      end
+
+      private
+
+      def requested_project_ids
+        Array(params[:project_ids]).flat_map { |value| value.to_s.split(',') }
+      end
+    end
+  end
+end
