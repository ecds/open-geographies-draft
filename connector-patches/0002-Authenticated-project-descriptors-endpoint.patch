diff --git a/app/services/core_data_connector/descriptors.rb b/app/services/core_data_connector/descriptors.rb
new file mode 100644
index 0000000..c0b7653
--- /dev/null
+++ b/app/services/core_data_connector/descriptors.rb
@@ -0,0 +1,85 @@
+module CoreDataConnector
+  # Builds the descriptor list for a project: its models, relationships, and
+  # user-defined fields, with stable identifiers (UUIDs) and display labels.
+  # Consumed by site/frontend configuration tooling to offer pick-lists
+  # instead of free-typed UUIDs.
+  class Descriptors
+    attr_reader :project_id
+
+    def initialize(project_id)
+      @project_id = project_id
+    end
+
+    def all
+      project_models + project_model_relationships
+    end
+
+    private
+
+    def project_models
+      descriptors = []
+
+      query = ProjectModel
+                .preload(:user_defined_fields)
+                .where(project_id:)
+
+      query.find_each do |project_model|
+        descriptors << {
+          identifier: project_model.uuid,
+          label: project_model.name,
+          kind: 'model'
+        }
+
+        project_model.user_defined_fields.each do |user_defined_field|
+          descriptors << {
+            identifier: user_defined_field.uuid,
+            label: user_defined_field.column_name,
+            context: project_model.name,
+            kind: 'field',
+            data_type: user_defined_field.data_type
+          }
+        end
+      end
+
+      descriptors
+    end
+
+    def project_model_relationships
+      descriptors = []
+
+      query = ProjectModelRelationship
+                .preload(:user_defined_fields, :primary_model)
+                .joins(:primary_model)
+                .where(primary_model: {
+                  project_id:
+                })
+
+      query.find_each do |project_model_relationship|
+        descriptor = {
+          identifier: project_model_relationship.uuid,
+          label: project_model_relationship.name,
+          context: project_model_relationship.primary_model.name,
+          kind: 'relationship'
+        }
+
+        if project_model_relationship.allow_inverse?
+          descriptor[:inverse_label] = project_model_relationship.inverse_name
+        end
+
+        descriptors << descriptor
+
+        project_model_relationship.user_defined_fields.each do |user_defined_field|
+          descriptors << {
+            identifier: user_defined_field.uuid,
+            label: user_defined_field.column_name,
+            context: project_model_relationship.name,
+            kind: 'field',
+            data_type: user_defined_field.data_type
+          }
+        end
+      end
+
+      descriptors
+    end
+  end
+end
