 .../public/v1/projects_controller.rb          | 70 +--------------
 .../core_data_connector/descriptors.rb        | 85 +++++++++++++++++++
 config/routes/admin.rb                        |  1 +
 4 files changed, 102 insertions(+), 68 deletions(-)
 create mode 100644 app/services/core_data_connector/descriptors.rb

diff --git a/app/controllers/core_data_connector/projects_controller.rb b/app/controllers/core_data_connector/projects_controller.rb
index 900c09d..0e611a9 100644
--- a/app/controllers/core_data_connector/projects_controller.rb
+++ b/app/controllers/core_data_connector/projects_controller.rb
@@ -27,6 +27,20 @@ module CoreDataConnector
       end
     end
 
+    # GET /core_data/projects/:id/descriptors
+    #
+    # The project's models, relationships, and user-defined fields, for
+    # configuration pick-lists (site editor, search collections). Same
+    # document as the public descriptors endpoint, but authenticated — the
+    # public endpoint only serves discoverable projects, while sites are
+    # configured before a project is made discoverable.
+    def descriptors
+      project = Project.find(params[:id])
+      authorize project, :show?
+
+      render json: { descriptors: Descriptors.new(project.id).all }, status: :ok
+    end
+
     def clear
       project = Project.find(params[:id])
       authorize project
